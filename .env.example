# InterviewAce Environment Configuration
# Copy this file to .env and insert your Gemini API Key(s)

# Primary Gemini API Key (Required for live AI inference)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_api_key_here
# Optional Multi-Key Failover / Quota Extension Keys
# (Must belong to different Google Cloud projects for distinct quota buckets)
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Maximum interview question budget (Default: 15)
MAX_QUESTIONS=15

# Upload limit for resume documents in bytes (Default: 5MB)
MAX_RESUME_BYTES=5242880

# CORS Allowed Origins (comma-separated, empty for same-origin)
ALLOWED_ORIGINS=

# Checkpoint database directory (local SQLite fallback; defaults to /tmp on serverless)
DATA_DIR=data

# --- Hosted MySQL Database Configuration (Optional for Cloud / Vercel persistence) ---
# Supports individual connection parameters or a single connection URL
# Examples: Aiven, PlanetScale, AWS RDS, TiDB Cloud, Railway
# MYSQL_URL=mysql://user:password@host:3306/interviewace?ssl=true
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL=false
